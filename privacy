<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
<meta name="theme-color" content="#0d0f17">
<title>Privacy Policy · Shiera AI</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
<style>
  :root{
    --bg-0:#07080d;--bg-1:#0d0f17;--bg-2:#12141d;
    --surface:#161923;--surface-2:#1c2030;--surface-3:#232838;
    --border:#262a3a;--border-light:#313649;
    --text-0:#f5f6fa;--text-1:#b8bcc9;--text-2:#7a7f92;
    --accent:#6366f1;--accent-2:#8b5cf6;--accent-glow:rgba(99,102,241,.35);
    --success:#10b981;--warning:#f59e0b;--danger:#ef4444;--pink:#ec4899;
    --radius:12px;--radius-lg:16px;
  }
  *{margin:0;padding:0;box-sizing:border-box}
  html{scroll-behavior:smooth}
  body{
    font-family:'Inter',-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif;
    background:var(--bg-0);color:var(--text-0);
    -webkit-font-smoothing:antialiased;line-height:1.7;
    min-height:100vh;overflow-x:hidden;
    background-image:
      radial-gradient(circle at 15% 0%, rgba(99,102,241,.10), transparent 40%),
      radial-gradient(circle at 90% 100%, rgba(139,92,246,.08), transparent 40%);
  }

  /* ===== NAVBAR ===== */
  .navbar{
    position:sticky;top:0;z-index:50;
    background:rgba(7,8,13,.82);
    backdrop-filter:blur(14px);-webkit-backdrop-filter:blur(14px);
    border-bottom:1px solid var(--border);
  }
  .nav-inner{
    max-width:900px;margin:0 auto;
    padding:14px 24px;
    display:flex;align-items:center;justify-content:space-between;gap:16px;
  }
  .brand{display:flex;align-items:center;gap:11px;text-decoration:none;color:inherit}
  .brand-logo{
    width:34px;height:34px;border-radius:10px;
    background:linear-gradient(135deg,#6366f1,#8b5cf6);
    display:grid;place-items:center;flex-shrink:0;
    box-shadow:0 6px 18px var(--accent-glow);
  }
  .brand-logo svg{width:18px;height:18px}
  .brand-text{font-weight:700;font-size:.9rem;line-height:1.2}
  .brand-text small{display:block;font-size:.63rem;font-weight:500;color:var(--text-2);text-transform:uppercase;letter-spacing:.05em;margin-top:1px}
  .nav-link{
    font-size:.8rem;font-weight:600;
    color:var(--text-1);text-decoration:none;
    padding:8px 14px;border-radius:99px;
    border:1px solid var(--border);
    background:var(--surface);
    transition:.18s;
    display:inline-flex;align-items:center;gap:7px;
  }
  .nav-link:hover{color:var(--text-0);border-color:var(--accent);background:var(--surface-2)}
  .nav-link svg{width:14px;height:14px}

  /* ===== MAIN ===== */
  .wrap{max-width:900px;margin:0 auto;padding:40px 24px 60px}

  .hero{
    text-align:center;
    padding:20px 10px 40px;
    border-bottom:1px solid var(--border);
    margin-bottom:36px;
  }
  .hero-icon{
    width:64px;height:64px;border-radius:20px;
    margin:0 auto 18px;
    background:linear-gradient(135deg,#6366f1,#8b5cf6);
    display:grid;place-items:center;
    box-shadow:0 12px 34px -8px var(--accent-glow);
  }
  .hero-icon svg{width:30px;height:30px;color:#fff}
  .hero h1{font-size:1.9rem;font-weight:700;letter-spacing:-.02em;margin-bottom:10px}
  .hero p{font-size:.9rem;color:var(--text-2);max-width:520px;margin:0 auto;line-height:1.65}
  .hero .meta{
    display:inline-flex;align-items:center;gap:8px;
    margin-top:18px;padding:6px 14px;border-radius:99px;
    background:rgba(99,102,241,.1);border:1px solid rgba(99,102,241,.28);
    font-size:.72rem;font-weight:600;color:#a5b4fc;
    font-family:'JetBrains Mono',monospace;
  }
  .hero .meta .dot{width:6px;height:6px;border-radius:50%;background:var(--success);box-shadow:0 0 8px var(--success)}

  /* ===== TOC ===== */
  .toc{
    background:var(--surface);border:1px solid var(--border);
    border-radius:var(--radius-lg);padding:20px 22px;margin-bottom:32px;
  }
  .toc-title{
    font-size:.68rem;font-weight:700;color:var(--text-2);
    text-transform:uppercase;letter-spacing:.1em;margin-bottom:12px;
    display:flex;align-items:center;gap:8px;
  }
  .toc-title svg{width:14px;height:14px}
  .toc ol{list-style:none;display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:6px 16px}
  .toc ol li{counter-increment:toc}
  .toc ol li a{
    display:flex;align-items:center;gap:9px;
    font-size:.82rem;color:var(--text-1);text-decoration:none;
    padding:6px 8px;border-radius:8px;transition:.15s;
  }
  .toc ol li a:hover{background:var(--surface-2);color:var(--text-0)}
  .toc ol li a::before{
    content:counter(toc,decimal-leading-zero);
    font-family:'JetBrains Mono',monospace;font-size:.7rem;
    color:var(--accent-2);font-weight:600;flex-shrink:0;
  }

  /* ===== SECTION ===== */
  .section{
    background:var(--surface);border:1px solid var(--border);
    border-radius:var(--radius-lg);padding:26px 28px;margin-bottom:18px;
    scroll-margin-top:80px;
  }
  .section h2{
    font-size:1.15rem;font-weight:700;letter-spacing:-.01em;
    margin-bottom:14px;display:flex;align-items:center;gap:11px;
  }
  .section h2 .num{
    width:28px;height:28px;border-radius:8px;flex-shrink:0;
    background:linear-gradient(135deg,rgba(99,102,241,.15),rgba(139,92,246,.08));
    border:1px solid rgba(99,102,241,.25);
    display:grid;place-items:center;
    font-family:'JetBrains Mono',monospace;font-size:.72rem;
    color:#a5b4fc;font-weight:600;
  }
  .section p{font-size:.88rem;color:var(--text-1);margin-bottom:12px;line-height:1.75}
  .section p:last-child{margin-bottom:0}
  .section ul,.section ol{margin:10px 0 12px 22px}
  .section li{font-size:.87rem;color:var(--text-1);margin-bottom:6px;line-height:1.7}
  .section li::marker{color:var(--accent-2)}
  .section strong{color:var(--text-0);font-weight:600}
  .section code{
    font-family:'JetBrains Mono',monospace;font-size:.82em;
    background:var(--bg-2);padding:2px 6px;border-radius:5px;
    border:1px solid var(--border);color:#a5b4fc;
  }
  .section a{
    color:#a5b4fc;text-decoration:none;
    border-bottom:1px solid rgba(165,180,252,.3);
    transition:.15s;
  }
  .section a:hover{border-bottom-color:#a5b4fc}

  .highlight{
    background:rgba(99,102,241,.08);
    border-left:3px solid var(--accent);
    padding:14px 18px;border-radius:10px;
    margin:14px 0;
    font-size:.86rem;color:var(--text-1);
    line-height:1.7;
  }
  .highlight strong{color:#c7d2fe}

  .warn{
    background:rgba(245,158,11,.08);
    border-left:3px solid var(--warning);
    padding:14px 18px;border-radius:10px;
    margin:14px 0;
    font-size:.86rem;color:var(--text-1);
    line-height:1.7;
  }
  .warn strong{color:#fbbf24}

  /* ===== TABLE ===== */
  .tbl-wrap{overflow-x:auto;margin:14px 0;border-radius:10px;border:1px solid var(--border)}
  table{width:100%;border-collapse:collapse;font-size:.84rem}
  th,td{padding:11px 14px;text-align:left;border-bottom:1px solid var(--border);vertical-align:top}
  th{
    background:var(--bg-2);font-weight:700;color:var(--text-0);
    font-size:.72rem;text-transform:uppercase;letter-spacing:.05em;
  }
  td{color:var(--text-1)}
  tr:last-child td{border-bottom:none}
  tr:hover td{background:rgba(99,102,241,.04)}

  /* ===== FOOTER ===== */
  footer{
    margin-top:36px;padding-top:22px;
    border-top:1px solid var(--border);
    text-align:center;font-size:.74rem;color:var(--text-2);
  }
  footer .thanks{margin-bottom:8px;font-size:.78rem}
  footer .thanks strong{
    background:linear-gradient(90deg,#6366f1,#8b5cf6,#ec4899);
    -webkit-background-clip:text;-webkit-text-fill-color:transparent;
    background-clip:text;font-weight:700;letter-spacing:.03em;
  }
  footer .heart{display:inline-block;animation:heartBeat 1.6s ease-in-out infinite;margin:0 3px}
  @keyframes heartBeat{0%,100%{transform:scale(1)}25%{transform:scale(1.22)}50%{transform:scale(1)}}
  footer a{color:var(--text-1);text-decoration:none;border-bottom:1px solid var(--border-light);transition:.15s}
  footer a:hover{color:var(--accent-2);border-bottom-color:var(--accent-2)}

  ::-webkit-scrollbar{width:9px;height:9px}
  ::-webkit-scrollbar-track{background:transparent}
  ::-webkit-scrollbar-thumb{background:var(--border-light);border-radius:99px}
  ::-webkit-scrollbar-thumb:hover{background:#3f4560}

  @media (max-width:640px){
    .nav-inner{padding:12px 16px}
    .wrap{padding:24px 16px 40px}
    .hero{padding:12px 6px 28px;margin-bottom:24px}
    .hero h1{font-size:1.4rem}
    .hero p{font-size:.84rem}
    .section{padding:20px 18px}
    .section h2{font-size:1rem;gap:9px}
    .section h2 .num{width:24px;height:24px;font-size:.66rem}
    .section p,.section li{font-size:.84rem}
    .toc{padding:16px 16px}
    .toc ol{grid-template-columns:1fr}
    .nav-link{padding:7px 11px;font-size:.74rem}
    .nav-link .txt{display:none}
    th,td{padding:9px 11px;font-size:.78rem}
  }
</style>
</head>
