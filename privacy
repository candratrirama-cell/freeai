<script>
/* Smooth scroll untuk link TOC */
document.querySelectorAll('.toc a[href^="#"], footer a[href^="#"]').forEach(a=>{
  a.addEventListener('click', (e)=>{
    const id = a.getAttribute('href').slice(1);
    const el = document.getElementById(id);
    if(el){
      e.preventDefault();
      const y = el.getBoundingClientRect().top + window.pageYOffset - 80;
      window.scrollTo({ top: y, behavior: 'smooth' });
    }
  });
});

/* Highlight section aktif saat scroll */
const sections = document.querySelectorAll('.section');
const tocLinks = document.querySelectorAll('.toc a[href^="#"]');
const observer = new IntersectionObserver((entries)=>{
  entries.forEach(entry=>{
    if(entry.isIntersecting){
      const id = entry.target.id;
      tocLinks.forEach(link=>{
        link.style.background = link.getAttribute('href') === '#'+id ? 'var(--surface-2)' : '';
        link.style.color = link.getAttribute('href') === '#'+id ? 'var(--text-0)' : '';
      });
    }
  });
}, { rootMargin: '-80px 0px -60% 0px' });
sections.forEach(s => observer.observe(s));
</script>
